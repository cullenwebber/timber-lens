{
  "name": "timber-lens",
  "displayName": "Timber Lens",
  "description": "Timber + Twig + ACF aware autocomplete, hover, diagnostics and navigation for WordPress projects.",
  "version": "0.3.0",
  "publisher": "timber-lens",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cullenwebber/timber-lens.git"
  },
  "bugs": {
    "url": "https://github.com/cullenwebber/timber-lens/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Other"
  ],
  "keywords": [
    "timber",
    "twig",
    "acf",
    "wordpress",
    "php"
  ],
  "activationEvents": [
    "onLanguage:twig",
    "workspaceContains:**/*.twig",
    "workspaceContains:**/acf-json/**"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "twig",
        "aliases": [
          "Twig",
          "twig"
        ],
        "extensions": [
          ".twig"
        ]
      }
    ],
    "commands": [
      {
        "command": "timberLens.reindex",
        "title": "Timber Lens: Reindex Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "timberLens.showTemplateContext",
        "title": "Timber Lens: Show Template Context"
      },
      {
        "command": "timberLens.createBlockTemplate",
        "title": "Timber Lens: Create Block Template from ACF Layout",
        "icon": "$(new-file)"
      },
      {
        "command": "timberLens.insertFieldStructure",
        "title": "Timber Lens: Insert ACF Field Structure"
      },
      {
        "command": "timberLens.applyFieldStructure",
        "title": "Timber Lens: Apply Field Structure to ACF JSON"
      },
      {
        "command": "timberLens.regenerateFieldStructure",
        "title": "Timber Lens: Regenerate Field Structure from ACF JSON"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "timberLens.templateContext",
          "name": "Timber Context",
          "when": "timberLens.active"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "timberLens.createBlockTemplate",
          "when": "view == timberLens.templateContext",
          "group": "navigation@1"
        },
        {
          "command": "timberLens.reindex",
          "when": "view == timberLens.templateContext",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "timberLens.insertFieldStructure",
          "when": "resourceExtname == .twig"
        },
        {
          "command": "timberLens.applyFieldStructure",
          "when": "resourceExtname == .twig"
        },
        {
          "command": "timberLens.regenerateFieldStructure",
          "when": "resourceExtname == .twig"
        }
      ]
    },
    "configuration": {
      "title": "Timber Lens",
      "properties": {
        "timberLens.twigRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "views",
            "templates",
            "components",
            "blocks",
            "partials"
          ],
          "description": "Directory names treated as Twig template roots. Include paths are resolved relative to these."
        },
        "timberLens.acfJsonPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "acf-json"
          ],
          "description": "Directories (relative to each workspace folder) scanned for ACF Local JSON."
        },
        "timberLens.phpScanGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/*.php"
          ],
          "description": "Glob patterns for PHP files scanned for Timber render context."
        },
        "timberLens.enableBuiltinGlobals": {
          "type": "boolean",
          "default": true,
          "description": "Suggest built-in Timber globals (post, site, user, menu) as fallback completions."
        },
        "timberLens.assumePostVariables": {
          "type": "boolean",
          "default": true,
          "description": "Treat otherwise-unresolved object variables (loop items, included variables, query results) as Timber posts, exposing post properties and ACF fields. Disable for stricter completion."
        },
        "timberLens.updateReferencesOnMove": {
          "type": "boolean",
          "default": true,
          "description": "When a Twig template or a folder of templates is moved or renamed in VS Code, update the include / extends / embed paths in Twig and the template paths in PHP that point at it."
        }
      }
    },
    "configurationDefaults": {
      "[twig]": {
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "on",
          "strings": "off"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node ./out/test/run.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.4.0"
  }
}
